# Copy to .env.local and fill in. All of these are optional; the defaults are in src/content/site.ts.

# Folder the installers are served from (no trailing slash).
# Default: the GitHub release in src/content/site.ts. Use /downloads for files copied into public/downloads/.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=

# Supabase project used by /desktop-login. Defaults to the one shipped inside the Ekspo app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 once the Google provider is configured in Supabase.
NEXT_PUBLIC_GOOGLE_SIGNIN=
